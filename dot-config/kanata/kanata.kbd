#|
This text between the two pipe+octothorpe sequences is a multi-line comment.
|#

;; Text after double-semicolons are single-line comments.

#|
One defcfg entry may be added, which is used for configuration key-pairs. These
configurations change kanata's behaviour at a more global level than the other
configuration entries.
|#

(defcfg
  #|
  This configuration will process all keys pressed inside of kanata, even if
  they are not mapped in defsrc. This is so that certain actions can activate
  at the right time for certain input sequences. By default, unmapped keys are
  not processed through kanata due to a Windows issue related to AltGr. If you
  use AltGr in your keyboard, you will likely want to follow the simple.kbd
  file while unmapping lctl and ralt from defsrc.
  |#
  process-unmapped-keys yes
)

(defvirtualkeys
  com.mitchellh.ghostty nop0
  net.kovidgoyal.kitty nop0
)

(platform (macos)
  (defalias
    lctl lmet
    lmet lctl
    F13 F13
    F14 F14
    F15 F15
    F16 F16
    F17 F17
    F18 F18
    F19 F19
    F20 F20
    F21 F21  ;; overridden
    F22 F22))

(platform (macos)
  (defoverrides
    (F21) (lctl /)))

(platform (linux win)
  (defalias
    lctl lctl
    lmet lmet
    ;; F13 - mic - XF86Tools
    F13 F13
    ;; F14 - light bulb - XF86Launch5
    F14 F14
    ;; F15 - M1
    F15 F15
    ;; F16 - M2
    F16 F16
    ;; F17 - M3
    F17 F17
    ;; F18 - M4
    F18 (layer-switch bare)
    F19 F19
    F20 F20
    F21 F21
    F22 F22))

(platform (linux win)
  (defoverrides
    (rctl p) (lsft lctl lalt lmet p)))


(defvar
  tap-time 200
  hold-time 200
  mouse-interval 3
  mouse-distance 1
  mwheel-distance 40)

(defsrc
              esc
  F13 F14     grv
  F15 F16     tab q w e r t y u i o p
  F17 F18     caps a s d f g h j k l ;
  F19 F20     lshift z x c v b n m , . / rshift up
  F21 F22     lctl lmet lalt spc ralt  rctl left down right
)

(deflayer default
              @esc
  @F13 @F14   @grv
  @F15 @F16   @tab q      w      e      r      t y u      i      o      p
  @F17 @F18   @cap @hrm-a @hrm-s @hrm-d @hrm-f g h @hrm-j @hrm-k @hrm-l @hrm-semic
  @F19 @F20   lshift z    x      c      v      b n m      ,      .      / rshift up
  @F21 @F22   @lctl @lmet lalt @spc-raised ralt rctl  left down right
)

(deflayermap (bare)
  F18 (layer-switch default)
  _ use-defsrc
)

(deflayer raised
              esc
  @F13 @F14   grv
  @F15 @F16   @qclick _ @mw↑ _ r _ bspc home pgdn pgup end
  @F17 @F18   @cap @mw← @mw↓ @mw→ f _ left down up right _
  @F19 @F20   @fst mlft mmid mrgt v _ _ _ , _ / _ @m↑
  @F21 @F22   @lctl @lmet lalt @spc-raised ralt  @hyper @m← @m↓ @m→
)

(deftemplate hrm (tap-key hold-key)
  (tap-hold-order $tap-time 0 $tap-key $hold-key))

(defalias
  meh (multi lctl lmet lalt)
  hyper (multi lsft lctl lalt lmet)
  cap (tap-hold-press 500 500 esc @meh)
  esc (tap-hold-press 500 500 esc lrld)
  tab (tap-hold-press 500 500 tab @lmet)
  grv (tap-hold-press 500 500 grv (layer-while-held raised))
  spc-raised (tap-hold $tap-time $hold-time spc (layer-while-held raised))
  hrm-a (t! hrm a lsft)
  hrm-s (t! hrm s @lctl)
  hrm-d (t! hrm d @lmet)
  hrm-f (t! hrm f lalt)
  hrm-j (t! hrm j lalt)
  hrm-k (t! hrm k @lmet)
  hrm-l (t! hrm l @lctl)
  hrm-semic (t! hrm ; lsft)
  m↑ (movemouse-up $mouse-interval $mouse-distance)
  m← (movemouse-left $mouse-interval $mouse-distance)
  m↓ (movemouse-down $mouse-interval $mouse-distance)
  m→ (movemouse-right $mouse-interval $mouse-distance)
  mw↑ (mwheel-up $mouse-interval $mwheel-distance)
  mw← (mwheel-left $mouse-interval $mwheel-distance)
  mw↓ (mwheel-down $mouse-interval $mwheel-distance)
  mw→ (mwheel-right $mouse-interval $mwheel-distance)
  fst (movemouse-speed 200)
  qclick (macro-repeat mltp 30)
)
